# Public client configuration. Never use service_role, sb_secret_ or a DB password.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_PUBLISHABLE_OR_ANON_KEY
# API de rutas. En desarrollo usa http://127.0.0.1:3001 por defecto. En producción, usa el mismo origen si se deja vacío.
VITE_TCA_API_URL=
# Optional, country code + phone (Peru: 51...). Empty opens recipient selection.
VITE_WHATSAPP_NUMBER=
