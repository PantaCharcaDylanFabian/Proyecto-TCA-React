{
  "name": "proyecto-tca-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "bd",
    "back",
    "front"
  ],
  "scripts": {
    "dev": "npm --prefix front run dev",
    "dev:front": "npm --prefix front run dev",
    "start:back": "npm --prefix back start",
    "dev:back": "npm --prefix back run dev",
    "build": "npm --prefix front run build",
    "build:front": "npm --prefix front run build",
    "lint": "npm --prefix front run lint",
    "lint:front": "npm --prefix front run lint",
    "test": "npm --prefix front test && npm --prefix bd test && npm --prefix back test",
    "test:front": "npm --prefix front test",
    "test:bd": "npm --prefix bd test",
    "test:back": "npm --prefix back test",
    "ai:all": "npm --prefix back run ai:all",
    "ai:agent": "npm --prefix back run ai:agent",
    "quality:audit": "node back/scripts/antigravity-code-quality.mjs",
    "check": "npm --prefix front run check"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/vite": "^4.3.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6"
  }
}
