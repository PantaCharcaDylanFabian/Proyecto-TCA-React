# Configuración del Backend TCA
PORT=3001
NODE_ENV=development

# Credenciales de Supabase PostgreSQL (Opcional, cuenta con modo resiliente local)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_OR_SERVICE_KEY

# Google Antigravity & Gemini API (Opcional para modo generativo)
GEMINI_API_KEY=
